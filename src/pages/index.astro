---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>Welcome to my little corner of the internet.</h1>

			<p>
				This is a personal space for things I make, things I
				write, things I explore, and things I find worth sharing.
			</p>

			<p>
				You'll find projects, experiments, bits of code,
				creative work, poetry, thoughts, and occasional
				documentation of my pursuits outside the digital world.
			</p>

			<p>
				No particular theme, no particular agenda. Just
				an evolving collection of interests, ideas, and
				things accumulated along the way.
			</p>

			<p>
				Make yourself at home.
			</p>
		</main>
		<Footer />
	</body>
</html>
